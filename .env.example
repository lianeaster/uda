# Зразок оточення для продакшну. На сервері лежить як /etc/uda.env
# з правами root:uda 640 — усередині пароль до бази й секретний ключ,
# читати його мають лише root і сам застосунок.
# У репозиторій справжній .env не комітимо, він у .gitignore.
#
# ВАЖЛИВО: значення брати в подвійні лапки. Цей файл читає і systemd, і
# скрипти в deploy/ через `source`. Systemd стерпить пробіли без лапок,
# bash — ні, тож лапки роблять обидва варіанти передбачуваними.

# Згенерувати один раз:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=""

# 0 на проді. Завжди. Без варіантів.
DJANGO_DEBUG="0"

# Домени через кому, без схеми й без слешів. Поки домену немає — IP сервера.
DJANGO_ALLOWED_HOSTS="18.185.95.197"

# Редирект на https, HSTS і secure-куки. Потрібен сертифікат, тож поки сайт
# стоїть на голому IP — тут 0, інакше буде петля редиректів і не спрацює
# логін (браузер не віддає secure-куки по http).
# Повернути в 1 одразу після certbot — це цільовий стан.
DJANGO_SECURE_SSL="0"

# Необовʼязково: якщо не задати, збереться з DJANGO_ALLOWED_HOSTS
# як https://<домен>. Задавати лише для нестандартних випадків —
# інший порт, тимчасовий http-домен.
# DJANGO_CSRF_TRUSTED_ORIGINS="https://uda.org.ua,https://www.uda.org.ua"

# Наявність DJANGO_DB_NAME перемикає проєкт на PostgreSQL.
# Прибрати змінну — повернеться SQLite (так працює локальна розробка).
DJANGO_DB_NAME="uda"
DJANGO_DB_USER="uda"
DJANGO_DB_PASSWORD=""
DJANGO_DB_HOST="127.0.0.1"
DJANGO_DB_PORT="5432"
